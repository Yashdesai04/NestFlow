datasource db {
  provider = "postgresql"
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

// 1. Enums
enum Role {
  TENANT
  LANDLORD
  ADMIN
}

enum KycStatus {
  UNSUBMITTED
  PENDING
  APPROVED
  REJECTED
}

// 2. User Model (Synced with Clerk)
model User {
  id             String    @id @default(cuid())
  clerkId        String    @unique
  email          String    @unique
  fullName       String?
  phone          String?
  avatarUrl      String?
  role           Role      @default(TENANT)
  isVerified     Boolean   @default(false)
  kycStatus      KycStatus @default(UNSUBMITTED)
  kycDocumentUrl String?

  properties   Property[]
  leases       Lease[]
  payments     Payment[]
  applications RentalApplication[]
  gatePasses   GatePass[]
  mealOptOuts  MealOptOut[]
  maintenance  MaintenanceTicket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// 3. Property Model
enum PropertyType {
  PG
  HOSTEL
  FLAT
  HOUSE
  OFFICE
}

enum GenderPolicy {
  BOYS_ONLY
  GIRLS_ONLY
  CO_ED
  FAMILY_ONLY
}

enum TargetAudience {
  STUDENTS
  WORKING_PROFESSIONALS
  FAMILY
  ALL
}

enum LeasingType {
  BED_LEVEL
  FULL_UNIT
}

enum BedStatus {
  VACANT
  OCCUPIED
  MAINTENANCE
}

model Property {
  id             String         @id @default(cuid())
  landlordId     String
  landlord       User           @relation(fields: [landlordId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  propertyType   PropertyType
  genderPolicy   GenderPolicy   @default(CO_ED)
  targetAudience TargetAudience @default(ALL)
  leasingType    LeasingType    @default(BED_LEVEL)

  address         String
  city            String
  state           String
  zipCode         String
  priceMonthly    Float?
  securityDeposit Float?
  images          String[]
  amenities       String[]
  isVerified      Boolean  @default(false)
  isFeatured      Boolean  @default(false)

  rooms        Room[]
  leases       Lease[]
  messMenus    MessMenu[]
  mealOptOuts  MealOptOut[]
  maintenance  MaintenanceTicket[]
  gatePasses   GatePass[]
  applications RentalApplication[]
  tours        PropertyTour[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// 4. Room Model
model Room {
  id           String              @id @default(uuid())
  propertyId   String
  roomNumber   String
  roomType     String? // e.g. "Single Sharing", "Double Sharing"
  createdAt    DateTime            @default(now())
  applications RentalApplication[]

  // Relations
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  beds     Bed[]
  leases   Lease[]
}

// 5. Bed Model
model Bed {
  id           String    @id @default(uuid())
  roomId       String
  bedNumber    String
  priceMonthly Float?
  status       BedStatus @default(VACANT)
  createdAt    DateTime  @default(now())

  // Relations
  room         Room                @relation(fields: [roomId], references: [id], onDelete: Cascade)
  leases       Lease[]
  applications RentalApplication[]
}

// 6. Mess Menu Model (3 Meals per day for PGs)
model MessMenu {
  id         String   @id @default(uuid())
  propertyId String
  dayOfWeek  String // MONDAY, TUESDAY, etc.
  breakfast  String?
  lunch      String?
  snacks     String?
  dinner     String?
  createdAt  DateTime @default(now())

  // Relations
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, dayOfWeek])
}

// 7. Lease Agreement Model
model Lease {
  id            String      @id @default(cuid())
  tenantId      String
  tenant        User        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId    String
  property      Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomId        String?
  room          Room?       @relation(fields: [roomId], references: [id], onDelete: SetNull)
  bedId         String?
  bed           Bed?        @relation(fields: [bedId], references: [id], onDelete: SetNull)
  startDate     DateTime
  endDate       DateTime?
  rentAmount    Float
  depositAmount Float       @default(0.0)
  status        LeaseStatus @default(ACTIVE)

  // E-Sign Lease Fields
  isSigned        Boolean   @default(false)
  tenantSignature String? // Stores Base64 signature data
  signedAt        DateTime?
  termsAccepted   Boolean   @default(false)

  payments  Payment[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  @@index([tenantId])
  @@index([propertyId])
}

enum LeaseStatus {
  PENDING
  ACTIVE
  TERMINATED
  EXPIRED
}

// 8. Maintenance Ticket Model
model MaintenanceTicket {
  id          String         @id @default(cuid())
  propertyId  String
  property    Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenantId    String
  tenant      User           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  description String?
  priority    TicketPriority @default(MEDIUM)
  status      TicketStatus   @default(OPEN)

  // Staff & Vendor Assignment Fields
  assignedStaff  String? // e.g. "Apex Plumbing Services", "Rajesh (Electrician)"
  staffPhone     String? // e.g. "+91 98765 43210"
  estimatedCost  Float? // Estimated repair expense
  resolutionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
  @@index([tenantId])
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

model PropertyTour {
  id          String     @id @default(cuid())
  propertyId  String
  property    Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  visitorName String
  email       String
  phone       String?
  tourDate    DateTime
  timeSlot    String? // e.g. "10:00 AM - 11:00 AM"
  status      TourStatus @default(PENDING)
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt

  @@index([propertyId])
}

enum TourStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model MealOptOut {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     User     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  date       DateTime // Date of meal to skip
  breakfast  Boolean  @default(false)
  lunch      Boolean  @default(false)
  dinner     Boolean  @default(false)
  reason     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, date])
  @@index([propertyId, date])
}

model Payment {
  id            String        @id @default(cuid())
  leaseId       String
  lease         Lease         @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  tenantId      String
  tenant        User          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rentAmount    Float
  utilityAmount Float         @default(0.0)
  totalAmount   Float
  dueDate       DateTime?
  status        PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([tenantId])
  @@index([leaseId])
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  FAILED
}

model GatePass {
  id           String         @id @default(cuid())
  propertyId   String
  property     Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenantId     String
  tenant       User           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  visitorName  String
  visitorPhone String?
  purpose      String?
  passCode     String         @default(cuid())
  validDate    DateTime
  status       GatePassStatus @default(APPROVED)
  entryTime    DateTime?
  exitTime     DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @default(now()) @updatedAt

  @@index([propertyId])
  @@index([tenantId])
}

enum GatePassStatus {
  APPROVED
  CHECKED_IN
  CHECKED_OUT
  REVOKED
  EXPIRED
}

model RentalApplication {
  id             String            @id @default(cuid())
  propertyId     String
  property       Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenantId       String
  tenant         User              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roomId         String?
  room           Room?             @relation(fields: [roomId], references: [id], onDelete: SetNull)
  bedId          String?
  bed            Bed?              @relation(fields: [bedId], references: [id], onDelete: SetNull)
  status         ApplicationStatus @default(PENDING)
  moveInDate     DateTime
  monthlyIncome  Float?
  occupation     String?
  emergencyPhone String?
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([propertyId])
  @@index([tenantId])
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}
